---
layout: base.njk
---
<article class="article-page">
  <header class="article-header">
    <a class="back-link" href="/articles/">← Articles</a>
    <p class="article-date"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
    <h1>{{ title }}</h1>
    {% if description %}<p class="article-deck">{{ description }}</p>{% endif %}
  </header>
  <div class="prose">{{ content | safe }}</div>
  <a class="article-back" href="/articles/">← All articles</a>
</article>
