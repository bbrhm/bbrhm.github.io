<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f6f2eb" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#211e1a" media="(prefers-color-scheme: dark)">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <meta property="og:type" content="{% if article %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  {% if article %}<meta property="article:published_time" content="{{ page.date | isoDate }}">{% endif %}
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="alternate" type="application/atom+xml" title="Articles by bbrhm" href="/feed.xml">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>bbrhm<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="/#projects">Projects</a>
        <a href="/articles/"{% if section == "articles" %} aria-current="page"{% endif %}>Articles</a>
        <a href="{{ site.github }}">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main" tabindex="-1">{{ content | safe }}</main>
    <footer class="site-footer">
      <a class="footer-name" href="/">bbrhm<span aria-hidden="true">.</span><span class="footer-description">Personal projects &amp; writing</span></a>
      <div><a href="/feed.xml">RSS</a><a href="{{ site.github }}">GitHub <span aria-hidden="true">↗</span></a></div>
    </footer>
  </div>
</body>
</html>
